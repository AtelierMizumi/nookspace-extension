# NookSpace Supabase Integration Environment Variables
# Copy this file to .env or .env.local and fill in your Supabase project credentials.

# Your Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Publishable / Anon API Key (safe to use in browser extension client)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
